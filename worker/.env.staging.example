# Staging worker URL — consumed by plan 007 (Dioxus mobile) and plan 005 (flow-harness).
# Copy this file to `.env.staging` (gitignored) or wire into your mobile/harness config.
#
# After `bash worker/deploy.sh staging`, the staging worker is reachable at:
STAGING_WORKER_URL=https://bethere-staging.solana-thailand.workers.dev

# ─────────────────────────────────────────────────────────────────────────────
# Staging secrets (Plan 005 §3.1).
# Set with:  npx wrangler secret put <NAME> --env staging
# These MUST be separate from production — staging has its own JWT signing key
# and a separate Google OAuth redirect URI so the two environments cannot
# cross-authenticate.
# ─────────────────────────────────────────────────────────────────────────────

# JWT signing secret for staging sessions. Generate a fresh one:
#   openssl rand -hex 32
JWT_SECRET=

# Google OAuth — register a SECOND redirect URI in the Google Cloud OAuth app,
# pointing at the staging worker, so production and staging don't share a callback:
#   https://bethere-staging.solana-thailand.workers.dev/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bethere-staging.solana-thailand.workers.dev/api/auth/callback

# Google Service Account (Sheets API). Can reuse the production service account,
# but point staging at a SEPARATE test sheet so staging writes never touch prod data.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_TOKEN_URI=
GOOGLE_SHEET_ID=

# Staff / admin emails for the staging event.
STAFF_EMAILS=

# Phase 2 (Solana / Helius NFT minting) — use a DEVNET Helius key for staging.
HELIUS_RPC_URL=https://devnet.helius-rpc.com
HELIUS_API_KEY=
NFT_COLLECTION_MINT=
NFT_METADATA_URI=
NFT_IMAGE_URL=
